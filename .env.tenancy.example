TENANCY_ENABLED=false
CONTROL_PLANE_HOST=admin.counterpos.pk

# Central control-plane database. Never reuse a customer database here.
CONTROL_DB_DRIVER=mysql
CONTROL_DB_HOST=127.0.0.1
CONTROL_DB_PORT=3306
CONTROL_DB_DATABASE=
CONTROL_DB_USERNAME=
CONTROL_DB_PASSWORD=

# Only these MySQL hosts may be used by registered tenant credentials.
TENANT_DB_ALLOWED_HOSTS=127.0.0.1,localhost
TENANT_DB_NAME_PREFIX=
TENANT_DB_STRICT=false
TENANT_REQUIRE_VERIFIED_DOMAIN=true
TENANT_REQUIRE_SUBSCRIPTION=true
TENANT_RESOLUTION_CACHE_SECONDS=30
TENANT_RESOLUTION_CACHE_STORE=file

# Tenant runtime state is kept in the selected tenant database. Queue metadata
# is always stored centrally and each payload carries its tenant UUID.
SESSION_DRIVER=database
CACHE_DRIVER=file
QUEUE_CONNECTION=database

CONTROL_SESSION_COOKIE=counterpos_control_session
TENANT_SESSION_COOKIE_PREFIX=counterpos_tenant_
SESSION_SECURE_COOKIE=true
CONTROL_AUTH_TIMEOUT_SECONDS=1800

# Optional absolute paths. If omitted, common XAMPP locations are detected.
MYSQLDUMP_BINARY=
MYSQL_BINARY=
